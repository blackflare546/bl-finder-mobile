{
  "expo": {
    "name": "Bluetooth Finder",
    "slug": "bluetooth-5-finder",
    "version": "1.0.0",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/brand/bluetooth-finder-icon-1024.png",
    "scheme": "blfindermobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071B2B",
        "foregroundImage": "./assets/brand/bluetooth-finder-icon-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bluetoothfinder.mobile",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071B2B",
          "image": "./assets/brand/bluetooth-finder-icon-1024.png",
          "imageWidth": 180
        }
      ],
      [
        "react-native-ble-manager",
        {
          "neverForLocation": true,
          "isBleRequired": true,
          "bluetoothAlwaysPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40702590-5a29-4e4f-909d-fa99b3d0e922"
      }
    },
    "owner": "blackflare546s-team",
    "ios": {
      "bundleIdentifier": "com.bluetoothfinder.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
